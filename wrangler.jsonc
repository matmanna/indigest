{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "indigest",
  "main": "src/worker.ts",
  "compatibility_date": "2025-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "indigest.matmanna.dev/*",
      "zone_name": "matmanna.dev",
    },
    {
      "pattern": "*-indigest.matmanna.dev/*",
      "zone_name": "matmanna.dev",
    },
    {
      "pattern": "indigest.matmanna.dev",
      "zone_name": "matmanna.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/feed/*",
      "/events",
      "/interactions",
      "/slack",
      "/slack/",
      "/spec.json",
    ],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_BINDING",
      "id": "af08c1f1e52543949fae23f29a7f939b",
    },
  ],
  "vars": {
    "API_USERNAME": "admin",
    "LOCKDOWN_USERS": "U07VA44DNBA,U09Q8MLTE58,U07EB2Y76DP",
    "SLACK_CLIENT_ID": "2210535565.11557816933424",
  },
}
